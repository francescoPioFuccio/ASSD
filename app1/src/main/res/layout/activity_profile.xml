<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <TextView
                    android:id="@+id/tvFullName"
                    android:text=""
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            <Button
                    android:id="@+id/btnEditFullName"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="Modifica Nome"
                    android:contentDescription="Modifica il nome utente"
            android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Email con icona di modifica -->
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
            <TextView
                    android:id="@+id/tvEmail"
                    android:text=""
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            <Button
                    android:id="@+id/btnEditEmail"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="Modifica Email"
                    android:contentDescription="Modifica l'indirizzo email"
            android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Preferenze -->
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
            <TextView
                    android:text="Preferenze:"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            <TextView
                    android:id="@+id/tvPreferencesList"
                    android:text=""
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"/>
            <Button
                    android:id="@+id/btnEditPreferences"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="Modifica Preferenze"
                    android:contentDescription="Modifica le preferenze"
            android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Contenitore per le preferenze (inizialmente vuoto, verrà popolato dinamicamente) -->
        <LinearLayout
                android:id="@+id/preferencesContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
