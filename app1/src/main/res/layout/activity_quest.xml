<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#F5F5F5"
        android:gravity="center">

    <!-- Header con icona -->
    <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp"
            android:src="@android:drawable/ic_dialog_map"
            android:background="@drawable/circle_background"
            android:padding="20dp" />

    <!-- Messaggio di benvenuto -->
    <TextView
            android:id="@+id/welcomeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="🎉 Benvenuto al Museo! 🎉"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:gravity="center" />

    <!-- Nome del museo -->
    <TextView
            android:id="@+id/museumNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="📍 Nome Museo"
            android:textSize="18sp"
            android:textColor="#424242"
            android:gravity="center" />

    <!-- ID utente (per debug) -->
    <TextView
            android:id="@+id/userIdTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="👤 User ID"
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center" />

    <!-- Messaggio informativo -->
    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="✅ Il sistema di geofence sta funzionando correttamente!\n\nQuesto è solo un test. Quando implementerai le quest reali, questa schermata mostrerà le attività disponibili nel museo."
            android:textSize="16sp"
            android:textColor="#555555"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />

    <!-- Bottone per iniziare le quest -->
    <Button
            android:id="@+id/startQuestButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:text="🚀 Inizia le Quest!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_primary"
            android:elevation="4dp" />

    <!-- Bottone per tornare indietro -->
    <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⬅️ Torna Indietro"
            android:textSize="16sp"
            android:textColor="#2E7D32"
            android:background="@drawable/button_secondary"
            style="?android:attr/buttonBarButtonStyle" />

</LinearLayout>