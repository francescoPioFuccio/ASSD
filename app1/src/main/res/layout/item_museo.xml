<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Nome del museo -->
        <TextView
                android:id="@+id/textViewMuseoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome Museo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="8dp" />

        <!-- Posizione -->
        <TextView
                android:id="@+id/textViewLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Posizione"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:drawableStart="@android:drawable/ic_dialog_map"
                android:drawablePadding="8dp"
                android:layout_marginBottom="4dp" />

        <!-- Tempo di visita -->
        <TextView
                android:id="@+id/textViewTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tempo visita"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:drawableStart="@android:drawable/ic_menu_recent_history"
                android:drawablePadding="8dp" />

        <!-- Pulsante opzionale per azioni -->
        <Button
                android:id="@+id/buttonViewDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="Dettagli"
                android:textSize="12sp"
                style="@style/Widget.AppCompat.Button.Borderless" />

    </LinearLayout>

</androidx.cardview.widget.CardView>