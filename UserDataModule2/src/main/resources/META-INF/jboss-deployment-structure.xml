<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2">
    <deployment>
        <exclusions>
            <!-- Evita conflitti: escludi Jersey se accidentalmente incluso -->
            <module name="org.glassfish.jersey.core.jersey-common"/>
            <module name="org.glassfish.jersey.containers.jersey-container-servlet"/>
            <module name="org.glassfish.jersey.media.jersey-media-multipart"/>
        </exclusions>
        <!-- Opzionale: abilita RESTEasy multipart esplicitamente -->
        <dependencies>
            <module name="org.jboss.resteasy.resteasy-multipart-provider" services="import"/>
        </dependencies>
    </deployment>
</jboss-deployment-structure>